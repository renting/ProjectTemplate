{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Logging": {
    "RetentionDays": 365
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=VueAppAdmin;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "VueAppAdmin",
    "SignKey": "VueAppAdmin-REPLACE_WITH_A_STRONG_SECRET_KEY_AT_LEAST_32_CHARS",
    "TokenExpirationHours": 8
  }
}
